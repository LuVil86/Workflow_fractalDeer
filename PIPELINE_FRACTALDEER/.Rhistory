############ %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% ###########################
######### Species distribution models (SDMs) based on ooportunistic data#########
##### - By Loreto Urbina ########################################################
library(terra)
############ functions #############
###corClass function: assign class to raster values
corClass<-function(x, id_column){
if(is.na(x)){return(NA)}
else if(!x%in%corresp_pix_classes[,id_column]){return(NA)}
else{
return(corresp_pix_classes[which(corresp_pix_classes[,id_column]==x), "new_short_class"][1]) #new_short_class is the new name of the column of the habitat correspondences file
}
}
### "extractCovariatesSimple" function: extract raster values to presences in vector format(dfvector)
extractCovariatesSimple<-function(raster, dFvector){
x<-terra::extract(raster,dFvector)[,2]
return(x)
}
############ entry presence data table ############
pt_dat<-read.csv("/media/loreto/Grande/ie-ofev-24-25/infofauna_jan2025/hermine_INFO_FAUNA.csv")
head(pt_dat)
############ Import the habitat map ############
HabitatRasterFolder="/media/loreto/NAS_DEVELOPPEMENT/IE_OFEV/Habitats"
##select source map
habitatRasterPath=paste0(HabitatRasterFolder,"/Hermine/HabitatMap_v1_44_hermine_251003.tif")
##create habitat raster object
land_use<-terra::rast(habitatRasterPath)
##create a data frame of correspondences
habitatCorrespondence=paste0(HabitatRasterFolder,"/Hermine/unique_habitat_hermine_03oct25.csv")
corresp_pix_classes<-read.csv(habitatCorrespondence,h=T)
############ Explore point data ############
###Read points and turn into vector file
pt_datVf<- terra::vect(pt_dat, geom = c("Coordx", "Coordy"))
save.image("/media/loreto/Grande/R_lore/sdm.Rdata")
