behaviourRefined<-paste0(dirPath,"/",gsub("_", " ", strsplit(fileName, split=".csv")[[1]][1])," REFINED ",toupper(parameter),".csv")
x<-getNSDValues(behaviourRefined, display="behaviour",save.plot=TRUE , mutate.df=FALSE, show.breakpoints = T)
