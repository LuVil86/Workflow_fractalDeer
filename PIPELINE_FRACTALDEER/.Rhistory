dat<-read.csv("/home/luvil/IE-OFEV/grisons_data/RED_DEER_GRISONS_fixes_counts.csv", h=T)
require(lubridate)
difftime(dat$endDT, dat$startDT)
difftime(dat$endDT, dat$startDT,units = "days")
round(difftime(dat$endDT, dat$startDT,units = "days"))
dat$Duration[days]<-round(difftime(dat$endDT, dat$startDT,units = "days"))
dat$Duration_days<-round(difftime(dat$endDT, dat$startDT,units = "days"))
dat$is_full_year<-unlist(lapply(dat$Duration_days, function(x) ifelse(x>364, "yes","no"))
dat$is_full_year<-unlist(lapply(dat$Duration_days, function(x) ifelse(x>364, "yes","no")))
head(dat)
write.csv(dat, file="/home/luvil/IE-OFEV/grisons_data/RED_DEER_GRISONS_fixes_counts.csv", row.names=F)
